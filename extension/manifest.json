{
  "manifest_version": 3,
  "name": "Browser Agent",
  "version": "0.2.0",
  "description": "Chat with the current page. Rearrange, hide, restyle, or edit content using your ChatGPT account.",
  "minimum_chrome_version": "116",
  "permissions": [
    "scripting",
    "sidePanel",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://youtube.com/*",
    "https://www.youtube.com/*",
    "https://m.youtube.com/*"
  ],
  "action": {
    "default_title": "Open Browser Agent"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:3210"
  },
  "key": "",
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
