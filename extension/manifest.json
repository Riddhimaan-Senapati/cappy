{
  "manifest_version": 3,
  "name": "Cappy",
  "version": "0.2.0",
  "description": "Adapts every website to your needs. Press the shortcut on any page and say what you need.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage", "tabs", "activeTab", "scripting", "tts", "offscreen", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "dist/background.js", "type": "module" },
  "action": { "default_title": "Cappy" },
  "side_panel": { "default_path": "sidepanel.html" },
  "commands": {
    "toggle-spotlight": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space",
        "mac": "Command+Shift+Space"
      },
      "description": "Open the Cappy bar"
    },
    "start-voice": {
      "suggested_key": { "default": "Alt+Shift+M" },
      "description": "Open the Cappy bar and start voice input"
    },
    "open-debug": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open the debug panel"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "dist/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "camera.html",
        "dist/camera.js",
        "vendor/*"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}