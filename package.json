{
  "name": "browser-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "server": "tsx watch server/index.ts",
    "build:ext": "esbuild background=extension/src/background/index.ts sidepanel=extension/src/sidepanel.ts popup=extension/src/popup.ts content=extension/src/content/index.ts --bundle --format=esm --target=chrome120 --outdir=extension/dist",
    "watch:ext": "esbuild background=extension/src/background/index.ts sidepanel=extension/src/sidepanel.ts popup=extension/src/popup.ts content=extension/src/content/index.ts --bundle --format=esm --target=chrome120 --outdir=extension/dist --watch",
    "dev": "npm run build:ext && concurrently -k -n server,ext \"npm run server\" \"npm run watch:ext\"",
    "typecheck": "tsc --noEmit",
    "chatgpt:login": "tsx server/auth/chatgpt.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@google/genai": "^3.3.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "jose": "^6.2.17",
    "openai": "^7.57.0",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
