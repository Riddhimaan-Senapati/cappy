# Real values go in the repo-root .env (the dev/start scripts load ../../.env).
# LLM_PROVIDER: gemini (default; stubs when no key) | chatgpt (uses `bun run chatgpt:login`) | stub
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_ADAPT_MODEL=gemini-3.6-flash
GEMINI_ADAPT_THINKING=LOW
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_CHAT_THINKING=LOW
# chatgpt only: model slug; empty means the first model listed for the account
CHATGPT_MODEL=
# chatgpt only: local port for the sign-in callback
CHATGPT_CALLBACK_PORT=1455
PORT=8787
