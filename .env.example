# gemini (default) | anthropic-key | openai-key | chatgpt-signin
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
# chatgpt-signin: run `npm run chatgpt:login` once (Plus/Pro plan, local use only)
CHATGPT_MODEL=gpt-6.1-sol
# low | medium | high (Anthropic only, lower is faster)
AGENT_EFFORT=low
PORT=8787
