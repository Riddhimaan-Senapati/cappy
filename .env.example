# Nothing here is required. Start the server, then sign in with ChatGPT or paste
# an API key from the extension settings. Keys added there are saved to
# .agent-keys.json (gitignored) next to the server, never in the extension.

# Optional: keys set here also work and show up as ready in settings.
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional: separate keys for voice (Settings > Model > Voice provider). Voice falls back to the keys above.
# OPENAI_AUDIO_API_KEY=
# GEMINI_AUDIO_API_KEY=

# Optional: which ready provider to use when none is picked in settings
# (chatgpt-signin | anthropic-key | openai-key | gemini).
# LLM_PROVIDER=

# Optional model overrides per tier (also selectable in settings).
# CHATGPT_MODEL_FAST=gpt-6-luna
# CHATGPT_MODEL_FRONTIER=gpt-6.1-sol
# ANTHROPIC_MODEL_FAST=claude-haiku-5-5
# ANTHROPIC_MODEL_FRONTIER=claude-opus-5-5
# OPENAI_MODEL_FAST=gpt-6-luna
# OPENAI_MODEL_FRONTIER=gpt-6.1-sol
# GEMINI_MODEL_FAST=gemini-3.6-flash
# GEMINI_MODEL_FRONTIER=gemini-4-hydrogen

# PORT=8787

# Optional: save readable LLM request/response YAML files in llm_logs/.
# Large request content (1,000+ characters) uses {{name__size_100_000}} placeholders.
log_llm_requests=false
